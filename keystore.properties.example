# Release 서명 설정 예시 파일.
# 실제 사용 시 이 파일을 keystore.properties 로 복사하고 값을 채워 넣으세요.
# keystore.properties 는 .gitignore 에 등록되어 있어 git에 커밋되지 않습니다.
#
# Keystore 생성 예시:
#   keytool -genkey -v -keystore release.jks -keyalg RSA -keysize 2048 \
#     -validity 10000 -alias dronepass
#
# 파일 위치는 프로젝트 루트 기준 상대경로로 지정합니다 (예: release.jks).

storeFile=release.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=dronepass
keyPassword=YOUR_KEY_PASSWORD
