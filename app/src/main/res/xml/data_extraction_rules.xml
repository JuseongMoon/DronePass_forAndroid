<?xml version="1.0" encoding="utf-8"?>
<!--
   DronePass Android - Data Extraction Rules (API 31+)
   https://developer.android.com/about/versions/12/backup-restore#xml-changes

   OS Auto Backup은 AndroidManifest.xml에서 비활성화되어 있다.
   이 파일은 allowBackup이 다시 켜졌을 때도 Firebase Auth/Google Sign-In
   토큰, FCM deviceId, 마지막 위치, Room 캐시가 시스템 백업/기기 전송으로
   복원되지 않도록 방어적으로 전체 로컬 저장소를 제외한다.
-->
<data-extraction-rules>
    <!-- 클라우드 백업 규칙 (Google 백업) -->
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>

    <!-- 기기 간 전송 규칙 (D2D Transfer) -->
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
