<?xml version="1.0" encoding="utf-8"?>
<!--
   DronePass Android - Auto Backup Rules (API 30 이하)
   https://developer.android.com/guide/topics/data/autobackup

   OS Auto Backup은 AndroidManifest.xml에서 비활성화되어 있다.
   이 파일은 allowBackup이 다시 켜졌을 때도 로컬 인증/위치/캐시 상태가
   시스템 백업으로 유출되지 않도록 방어적으로 전체 로컬 저장소를 제외한다.
   API 31+에서는 data_extraction_rules.xml이 사용된다.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
