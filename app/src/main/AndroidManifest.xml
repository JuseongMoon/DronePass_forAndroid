<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Android 11+ package visibility 대응.
        ShapeDetailSheet 등에서 외부 지도 앱(카카오맵/티맵/네이버맵/구글맵)을
        intent로 열 때 resolveActivity() 가 null 을 반환하지 않도록
        <queries> 블록에 패키지/인텐트 가시성을 선언한다.
    -->
    <queries>
        <!-- 외부 지도 앱 패키지 (도형 위치 열기) -->
        <package android:name="net.daum.android.map" />
        <package android:name="com.skt.tmap.ku" />
        <package android:name="com.nhn.android.nmap" />
        <package android:name="com.google.android.apps.maps" />

        <!-- 일반적인 https URL 뷰어 (브라우저 등) -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
    </queries>

    <!-- 인터넷 권한 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 위치 권한 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- 알림 권한 (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 정확한 알람 예약 권한 (Android 12+) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- 재부팅 후 알림 재예약을 위한 권한 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".app.DronePassApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:forceDarkAllowed="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DronePassAndroid"
        tools:targetApi="tiramisu">

        <!-- 네이버 지도 NCP 키 (local.properties에서 로드) -->
        <meta-data
            android:name="com.naver.maps.map.NCP_KEY_ID"
            android:value="${NAVER_MAP_CLIENT_ID}" />

        <!-- AppCompat per-app language 저장 (Android 12 이하 포함) -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.DronePassAndroid"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FCM 서비스 -->
        <service
            android:name=".service.FcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- 로컬 알림 리시버 -->
        <receiver
            android:name=".service.NotificationReceiver"
            android:exported="false" />

        <!-- 재부팅 시 알림 재예약 리시버 -->
        <receiver
            android:name=".service.BootCompletedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- 일부 OEM (특히 중국계) 이 explicit category.DEFAULT 가 없는 receiver 를
                     필터링하는 경우가 있어 명시 추가. AOSP 동작에는 영향 없음. -->
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
